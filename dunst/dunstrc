[global]
origin = top-right
offset = 10x10
font = Hack Nerd Font 12
frame_width = 2
frame_color = #7c6f64
separator_color = frame
separator_height = 6
padding = 10
horizontal_padding = 12
gap_size = 8
icon_position = left
min_icon_size = 32
max_icon_size = 64

[urgency_low]
background = #282828
foreground = #bdae93
timeout = 4

[urgency_normal]
background = #282828
foreground = #d4d4d4
timeout = 6

[urgency_critical]
background = #282828
foreground = #fb4934
frame_color = #fb4934
timeout = 0
