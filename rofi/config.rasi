configuration {
    font: "Hack Nerd Font 12";
    show-icons: true;
}

* {
    background: #282828;
    foreground: #d4d4d4;
    muted: #bdae93;
    border: #7c6f64;
    red: #fb4934;
    green: #b8bb26;
    yellow: #fabd2f;
    blue: #83a598;
}

window {
    width: 720px;
    location: center;
    border: 2px;
    border-color: @border;
    background-color: @background;
}

mainbox {
    padding: 16px;
    spacing: 12px;
    children: [ inputbar, listview ];
}

inputbar {
    spacing: 8px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @yellow;
}

entry {
    placeholder: "search";
    placeholder-color: @muted;
    text-color: @foreground;
}

listview {
    lines: 10;
    fixed-height: false;
    scrollbar: false;
    spacing: 4px;
}

element {
    padding: 6px 8px;
}

element normal.normal {
    background-color: transparent;
    text-color: @foreground;
}

element alternate.normal {
    background-color: transparent;
    text-color: @foreground;
}

element selected.normal {
    background-color: @blue;
    text-color: @background;
}

element normal.active {
    text-color: @green;
}

element selected.active {
    background-color: @green;
    text-color: @background;
}

element normal.urgent {
    text-color: @red;
}

element selected.urgent {
    background-color: @red;
    text-color: @background;
}

element-icon {
    size: 1.2em;
    spacing: 8px;
}

element-text {
    vertical-align: 0.5;
}
