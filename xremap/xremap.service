[Unit]
Description=xremap Super clipboard trial
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/xremap --desktop wlroots --device "keyd virtual keyboard" --watch=device --output-device-name xremap-super-cv --vendor 0x0FAC --product 0x0AE0 "%E/xremap/config.yml"
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal
