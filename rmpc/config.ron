#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]

(
    album_art: (method: Sixel),
    keybinds: (
        clear: true,
        global: {
            "<C-q>": Quit,
            "?": ShowHelp,
            ":": CommandMode,
            "<Space>": TogglePause,
            "<C-n>": NextTrack,
            "<C-p>": PreviousTrack,
            "<": SeekBack,
            ">": SeekForward,
            "R": ToggleRepeat,
            "C": ToggleConsume,
            "Q": SwitchToTab("Queue"),
            "D": SwitchToTab("Directories"),
            "A": SwitchToTab("Albums"),
            "P": SwitchToTab("Playlists"),
            "S": SwitchToTab("Search"),
            "gt": NextTab,
            "gT": PreviousTab,
            "<Tab>": NextTab,
            "<S-Tab>": PreviousTab,
            "U": Rescan,
        },
        navigation: {
            "<Esc>": Close,
            "<C-c>": Close,
            "<Enter>": Confirm,
            "h": Left,
            "j": Down,
            "k": Up,
            "l": Right,
            "<Left>": Left,
            "<Down>": Down,
            "<Up>": Up,
            "<Right>": Right,
            "<C-h>": PaneLeft,
            "<C-j>": PaneDown,
            "<C-k>": PaneUp,
            "<C-l>": PaneRight,
            "<C-w>h": PaneLeft,
            "<C-w>j": PaneDown,
            "<C-w>k": PaneUp,
            "<C-w>l": PaneRight,
            "gg": Top,
            "G": Bottom,
            "<C-u>": UpHalf,
            "<C-d>": DownHalf,
            "<C-b>": PageUp,
            "<C-f>": PageDown,
            "K": MoveUp,
            "J": MoveDown,
            "v": Select,
            "<C-Space>": InvertSelection,
            "/": EnterSearch,
            "n": NextResult,
            "N": PreviousResult,
            "a": Add,
            "dd": Delete,
            "i": FocusInput,
            "<C-s>s": Save(kind: Modal()),
        },
        queue: {
            "<Enter>": Play,
            "dd": Delete,
        },
    ),
)
